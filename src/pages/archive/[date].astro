---
import Shell from '../../layouts/Shell.astro';
import Story from '../../components/Story.astro';
import {data,editionStories,day} from '../../lib';
export function getStaticPaths(){return Object.entries(data.briefs).map(([date,ids])=>({params:{date},props:{date,ids}}))}
const {date}=Astro.props;
const items=editionStories(date);
---
<Shell title={day(date)}><div class="intro"><p class="eyebrow">{day(date)}</p><h1>המהדורה היומית</h1></div>{!items.length && <p>אין ידיעות בעברית במהדורה זו.</p>}{items.map((s,i)=><Story story={s} lead={i===0}/>)}</Shell>