---
import Shell from '../layouts/Shell.astro';
import Story from '../components/Story.astro';
import {data,stories,topics,day} from '../lib';
const date=Object.keys(data.briefs).sort().at(-1);
const feed=stories;
---
<Shell title="העדכונים">
<div class="intro"><p class="eyebrow">{date ? day(date) : 'ממתינים למהדורה הראשונה'}</p><h1>העדכונים<span>.</span></h1><p class="deck">העדכונים האחרונים בכל הנושאים.</p></div>
<div class="filters chips" role="group" aria-label="סינון לפי נושא">{topics.map(t=><button data-filter={t.id} aria-pressed="false">{t.name}</button>)}</div>
<section id="feed" aria-label="רשימת עדכונים">{feed.map((s)=><Story story={s} />)}</section>
<p id="feed-empty" role="status" hidden={feed.length>0}>אין כרגע ידיעות בעברית בתצוגה זו.</p>
<div id="feed-end"><button id="more" hidden>טעינת ידיעות נוספות</button></div>
</Shell>
<script>
const feed=document.querySelector('#feed')!;
const ranked=[...feed.querySelectorAll<HTMLElement>('[data-story]')];
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
const more=document.querySelector<HTMLButtonElement>('#more')!;
let filter='', limit=16;
function render(){
 let count=0;
 for(const row of ranked){
   const match=!filter||row.dataset.topic===filter;
   row.hidden=!match||count>=limit;
   if(match)count++;
   feed.append(row);
 }
 document.querySelector<HTMLElement>('#feed-empty')!.hidden=count>0;
 more.hidden=count<=limit;
}
function load(){if(!more.hidden){limit+=16;render();}}
for(const button of buttons)button.addEventListener('click',()=>{
 filter=filter===button.dataset.filter?'':button.dataset.filter!;limit=16;
 for(const choice of buttons)choice.setAttribute('aria-pressed',String(choice.dataset.filter===filter));
 render();
});
more.addEventListener('click',load);
render();
if('IntersectionObserver' in window)new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting))load();},{rootMargin:'200px'}).observe(document.querySelector('#feed-end')!);
</script>