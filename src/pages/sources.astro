---
import Shell from '../layouts/Shell.astro';
import {sources,topicName,data,stamp,sourceEdition} from '../lib';
---
<Shell title="Sources"><div class="intro"><h1>Sources</h1><p class="deck">Publishers and feeds used to compile the briefing.</p></div>{sources.filter(s=>s.enabled).map(s=><article class="story"><p class="eyebrow">{topicName(s.topic)} · {sourceEdition(s.id)==="israel"?"Israel":"Global"}</p><h3>{s.publisher}</h3><a href={s.url}>{s.method} feed ↗</a><p class="meta">{data.feeds[s.id]?.ok===false?'Refresh failed':data.feeds[s.id]?.ok?'Available':'Awaiting refresh'}{data.feeds[s.id]?.lastSuccess && ' · '+stamp(data.feeds[s.id].lastSuccess!)}</p></article>)}</Shell>