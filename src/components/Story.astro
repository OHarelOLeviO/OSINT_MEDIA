---
import {url,stamp,topicName,mainIdea,storyEditions,inHebrew,sourcePlatform,type Story} from '../lib';
const {story:s,lead=false,featured=false}=Astro.props as {story:Story;lead?:boolean;featured?:boolean};
const hebrew=inHebrew(s.title);
const idea=mainIdea(s);
const platform=sourcePlatform(s.coverage[0]?.source);
const hebrewTopics:Record<string,string>={world:'עולם וגאופוליטיקה',politics:'פוליטיקה וממשל',finance:'כלכלה ושווקים',technology:'טכנולוגיה ובינה מלאכותית',space:'חלל ואסטרונומיה',sports:'ספורט'};
const symbols:Record<string,string>={world:'◎',politics:'◇',finance:'↗',technology:'✳',space:'✦',sports:'◈'};
---
<article class:list={['story','post',{lead}]} data-story lang={hebrew?"he":"en"} dir={hebrew?"rtl":"ltr"} data-hebrew={hebrew?"1":"0"} data-topic={s.topic} data-editions={storyEditions(s).join(" ")} data-reported={s.reported} data-date={s.reported.slice(0,10)} data-source={s.coverage.map(x=>x.source).join(' ')} data-search={[s.title,topicName(s.topic),...s.coverage.flatMap(x=>[x.publisher,x.excerpt])].join(' ').toLowerCase()}>
<div class="post-top"><span class="avatar" aria-hidden="true">{symbols[s.topic] ?? '◇'}</span><div><strong>{s.coverage[0]?.publisher}{platform && platform!=="RSS" && " · "+platform}</strong><div class="meta"><time datetime={s.reported}>{stamp(s.reported)}</time></div></div>{featured && <span class="featured">{hebrew ? "תקציר יומי" : "Daily Brief"}</span>}</div>
<a class="eyebrow topic-link" href={url('topic/'+s.topic)}>{hebrew ? hebrewTopics[s.topic] ?? topicName(s.topic) : topicName(s.topic)}</a>
<h3><a class="post-link" href={url('story/'+s.id)}><bdi>{s.title}</bdi></a></h3>{idea && <p>{idea}</p>}
<div class="post-bottom"><span>{hebrew ? (idea?'מתוך המקור':'כותרת המקור') : (idea?'Source excerpt':'Source headline')}</span><span aria-hidden="true">{hebrew ? "לפרטי הידיעה ↖" : "Read briefing ↗"}</span></div>
</article>